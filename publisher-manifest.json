5rem;background:#fff}\n.device-grid .dev h4{margin:0 0 .3rem;font-size:1rem;color:#5d2bd1}\n.device-grid .dev p{font-size:.9rem;color:#2d2d36;margin:0}\n.split{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.5rem;margin-top:1.5rem}\n.split .panel{border:2px solid #1a1a22;padding:1.5rem;background:#fff}\n.split .panel h3{margin-bottom:.5rem}\n.split .panel ul{padding-left:1.1rem;margin:.5rem 0 0}\n.split .panel ul li{margin-bottom:.35rem}\n.faq details{border:2px solid #1a1a22;background:#fff;padding:0;margin-bottom:.75rem}\n.faq details summary{cursor:pointer;padding:1rem 1.25rem;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:1rem}\n.faq details summary::-webkit-details-marker{display:none}\n.faq details summary::after{content:\"+\";font-size:1.4rem;color:#5d2bd1;line-height:1;flex-shrink:0}\n.faq details[open] summary::after{content:\"−\"}\n.faq details .body{padding:0 1.25rem 1.25rem;color:#2d2d36;border-top:1px solid #d6d6dc}\n.cta{margin-top:1.5rem}\n.cta a.btn{display:inline-block;background:#5d2bd1;color:#fff;border:2px solid #5d2bd1;padding:.7rem 1.4rem;font-weight:600;border-bottom:2px solid #5d2bd1}\n.cta a.btn:hover{background:#3a1a8a;border-color:#3a1a8a;color:#fff}\nfooter.site{padding:3rem clamp(1.5rem,5vw,5rem) 2rem;border-top:2px solid #1a1a22;color:#5b5b66;font-size:.85rem;max-width:980px}\nfooter.site p{margin:0}\n@media(max-width:760px){\n.wrap{flex-direction:column}\nnav.side{position:relative;width:100%;height:auto;border-right:none;border-bottom:2px solid #1a1a22;padding:1.25rem}\nnav.side ol{display:flex;flex-wrap:wrap;gap:.4rem 1rem}\nnav.side ol li{margin:0}\nsection{padding:3rem 1.5rem}\nsection.hero{padding-top:3rem;padding-bottom:3rem}\n}\n</style><div class=\"wrap\">\n<nav class=\"side\" aria-label=\"页面目录\">\n<a class=\"brand\" href=\"#top\">善云 ShanCloud<small>ShanCloud / 2024 季度版</small></a>\n<ol>\n<li><a href=\"#story\">服务起源</a></li>\n<li><a href=\"#how\">线路怎么走</a></li>\n<li><a href=\"#plans\">月付套餐</a></li>\n<li><a href=\"#devices\">设备并行</a></li>\n<li><a href=\"#policy\">流量与策略</a></li>\n<li><a href=\"#faq\">常见问题</a></li>\n</ol>\n</nav>\n<main>\n<section class=\"hero\" id=\"top\">\n<span class=\"kicker\">Service Note · 善云小传</span>\n<h1>善云(ShanCloud) · 嗨，我是<span class=\"accent\">善云</span>。<br>我们做网络代理，只是想把路修得干净一点。</h1>\n<p class=\"lede\">善云 ShanCloud 是一套面向个人与小团队的代理订阅服务。我们不卖「一键飞跃世界」的口号，只想把节点、日志策略、并发设备这些真正影响体验的细节，一项一项摊开给你看。下面这张时间线，是我们从筹备到上线的几个关键节点。</p>\n<div class=\"timeline\">\n<div class=\"step\">\n<span class=\"ts\">2022 · 春</span>\n<h3>从一台工控机开始</h3>\n<p>两位创始人在朋友的工作室角落各搭了一台软路由，反复测试不同地区的出口延迟。这个阶段没有任何对外服务，只是想搞清楚一条「干净」的线路到底要避开哪些 ASN。</p>\n</div>\n<div class=\"step\">\n<span class=\"ts\">2022 · 秋</span>\n<h3>开放小范围邀请</h3>\n<p>先给身边的写作者、设计师、跨境电商卖家试用，每人每月一份反馈表。这个阶段我们没有公开定价，所有节点都是手工调度。</p>\n</div>\n<div class=\"step\">\n<span class=\"ts\">2023 · 春</span>\n<h3>上线第一版月付套餐</h3>\n<p>把朋友们的反馈聚成三档：一个人用、家里几个人用、十几人的小团队用。这就是你今天看到的「基础 / 旗舰 / 团队」三档的原型。</p>\n</div>\n<div class=\"step\">\n<span class=\"ts\">2024 · 至今</span>\n<h3>按季度调整节点与套餐</h3>\n<p>每过三个月，我们会复盘一次带宽成本和投诉率，再决定下一季是否增减节点、调整月费结构。当前页面展示的是 2024 季度版的现行规则。</p>\n</div>\n</div>\n</section>\n\n<section id=\"how\">\n<h2><span class=\"num\">02</span>线路是怎么走的</h2>\n<p>很多人一上来就问「你们用的是什么协议」，但协议本身并不是体验的决定性因素，决定性因素是这条链路上每一跳的拥堵程度。我们当前的节点主要落在三类回程：</p>\n<div class=\"split\">\n<div class=\"panel\">\n<h3>普通线路节点池</h3>\n<p>适合日常浏览、查资料、看图文。带宽充裕，单跳延迟通常在 80ms 到 160ms 之间浮动，夜间高峰偶尔会感觉到轻微抖动。</p>\n<ul>\n<li>典型用途：网页、邮箱、聊天、地图</li>\n<li>典型地区：东亚、东南亚、北美西海岸</li>\n</ul>\n</div>\n<div class=\"panel\">\n<h3>IPLC 专线节点</h3>\n<p>专线是包月带宽、不和公共出口抢资源的线路，丢包率几乎为零，适合对延迟敏感的任务，比如游戏语音、远程桌面、视频会议。</p>\n<ul>\n<li>典型用途：竞技类游戏、远程办公、视频会议</li>\n<li>典型地区：港、台、日、美东</li>\n</ul>\n</div>\n</div>\n<p>不同套餐能用哪类节点，会在下面的「月付套餐」里逐条列出。我们不把「专线」当作单独商品售卖，而是按套餐级别开放给对应用户。</p>\n</section>\n\n<section id=\"plans\">\n<h2><span class=\"num\">03</span>三档月付套餐</h2>\n<p>下面这三张卡片就是善云 ShanCloud 当季在售的全部套餐。按月付费更灵活，按年付费可以省下一笔小钱，相当于买两个月送一个月。每张卡片里都写清了：月费、年费、每月流量、并行设备数、可访问节点范围。</p>\n\n<div class=\"card\">\n<div class=\"plan-head\">\n<span class=\"name\">基础版</span>\n<span class=\"price\">¥15 / 月</span>\n<span class=\"annual\">按年付仅需 ¥150 / 年</span>\n</div>\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>可访问普通线路节点池</li>\n</ul>\n<p>适合一个人在家用，主要看网页、刷视频、轻度办公。</p>\n</div>\n\n<div class=\"card featured\">\n<div class=\"plan-head\">\n<span class=\"name\">旗舰版</span>\n<span class=\"price\">¥35 / 月</span>\n<span class=\"annual\">按年付仅需 ¥350 / 年</span>\n</div>\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n<p>家里两三口人共用，或者你需要在家里打游戏、视频会议，就是这一档。</p>\n</div>\n\n<div class=\"card\">\n<div class=\"plan-head\">\n<span class=\"name\">团队版</span>\n<span class=\"price\">¥85 / 月</span>\n<span class=\"annual\">按年付仅需 ¥850 / 年</span>\n</div>\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n<p>十几人的小工作室、跨境小组、需要稳定出口的小型业务。</p>\n</div>\n</section>\n\n<section id=\"devices\">\n<h2><span class=\"num\">04</span>设备并行是怎么算的</h2>\n<p>「同时在线」指的是同一个账号下、同一时间活跃的连接数。我们按常见的设备组合，列了几种典型场景，方便你对号入座：</p>\n<div class=\"device-grid\">\n<div class=\"dev\">\n<h4>一人独居</h4>\n<p>1 台主力电脑 + 1 台手机 + 1 台平板。基础版的 3 台刚好够用，旗舰版会更从容。</p>\n</div>\n<div class=\"dev\">\n<h4>两口之家</h4>\n<p>通常会涉及 2 部手机 + 1 台电脑 + 1 台电视盒子。旗舰版的 5 台刚好对位。</p>\n</div>\n<div class=\"dev\">\n<h4>小型工作室</h4>\n<p>工位上的电脑、测试用的手机、自带的笔记本都可能同时挂上。团队版的 20 台留有充足的余量。</p>\n</div>\n<div class=\"dev\">\n<h4>出差携带</h4>\n<p>笔记本 + 手机 + 随身路由器。出差路上临时增加设备很常见，建议选大一档的套餐。</p>\n</div>\n</div>\n<p>需要注意的是：设备并行数和「多少个客户端进程」不是同一回事。一个设备上启用了代理插件 + 系统代理 + 命令行工具，仍然只算一台设备。</p>\n</section>\n\n<section id=\"policy\">\n<h2><span class=\"num\">05</span>流量怎么算、有哪些策略</h2>\n<div class=\"split\">\n<div class=\"panel\">\n<h3>流量统计口径</h3>\n<p>我们按「出口侧实际下行 + 上行」双向计费，节点中转流量不计在内。每月 1 日 0 点重置，剩余流量不会滚入下月。</p>\n</div>\n<div class=\"panel\">\n<h3>节点调度策略</h3>\n<p>默认按延迟自动选择最优节点，你也可以在客户端里手动锁定某个具体节点。同一个账号在三个不同城市登录，我们会提醒你确认，避免账号被盗用。</p>\n</div>\n<div class=\"panel\">\n<h3>用尽流量之后</h3>\n<p>不会自动加购。当月流量用完之后，你可以继续以 ¥1 / GB 的单价补购，或等到下月 1 日自动恢复。三档套餐的单价相同。</p>\n</div>\n<div class=\"panel\">\n<h3>团队版的专属路由</h3>\n<p>团队版支持企业定制路由，比如「所有访问走香港出口」、「测试环境走美西」。定制需求会由专属客户经理与运维一起评估可行性。</p>\n</div>\n</div>\n<div class=\"cta\">\n<p>如果你想从基础版开始试用，可以直接进入下一节看看常见问题，再决定要不要订阅。</p>\n</div>\n</section>\n\n<section class=\"faq\" id=\"faq\">\n<h2><span class=\"num\">06</span>常见问题</h2>\n<p>下面这些问题是过去一年里朋友们问得最多的，我们整理成了可点击展开的形式。如果你看完之后还有疑问，欢迎写信给我们。</p>\n\n<details>\n<summary>善云 ShanCloud 适合哪些人用？</summary>\n<div class=\"body\">\n<p>适合对网络延迟、流量价格、并发设备有明确需求，并且愿意花五分钟读完一份套餐说明的人。我们不打算替你做选择，只把每档套餐写得足够透明，让你自己判断。</p>\n</div>\n</details>\n\n<details>\n<summary>月付套餐可以随时取消吗？</summary>\n<div class=\"body\">\n<p>月付套餐可以在下一个计费日前手动取消，已支付周期内的余额不会退回，但服务会一直保留到周期结束。按年付费的套餐同样在到期日之前有效，到期前 7 天我们会提醒你续费。</p>\n</div>\n</details>\n\n<details>\n<summary>旗舰版和团队版都能用 IPLC 专线吗？</summary>\n<div class=\"body\">\n<p>旗舰版包含 IPLC 专线的游戏加速优化通道，主要面向个人玩家和家庭。团队版默认不强制使用 IPLC，但可以在定制路由时要求把某些业务流量切到专线上，由专属客户经理和运维一起评估。</p>\n</div>\n</details>\n\n<details>\n<summary>套餐里的「极速流量」和普通流量有什么区别？</summary>\n<div class=\"body\">\n<p>我们当前在售的三档套餐，所有流量都是同一类节点出口，没有再细分「极速 / 普通」两套计量。「极速流量」只是表示这一档配额的常见用量 —— 比如 100GB 通常对应一个月里看网页、刷视频、偶尔下载文件的总和。</p>\n</div>\n</details>\n\n<details>\n<summary>为什么设备并行数要做限制？</summary>\n<div class=\"body\">\n<p>并发设备越多，同一节点下的带宽越容易被分摊。我们的节点按套餐级别分配带宽上限，超过这个上限就会出现可感知的卡顿。把并行数写进套餐，是为了保证每个用户都能拿到自己那一档承诺的体验。</p>\n</div>\n</details>\n\n<details>\n<summary>团队版的「专属客户经理」具体能做什么？</summary>\n<div class=\"body\">\n<p>对接发票、合同、定制路由、对公付款这些偏企业流程的事。日常节点使用问题还是优先走工单系统，这样技术同事能更快定位原因。</p>\n</div>\n</details>\n\n<details>\n<summary>如果我只是临时用几天，按月订阅划算吗？</summary>\n<div class=\"body\">\n<p>月付 ¥15 起，只用几天的话单价会偏高。我们正在筹备更短的体验方案，但当前季度版仍以月付和年付为主。</p>\n</div>\n</details>\n\n<details>\n<summary>可以在海外使用善云吗？</summary>\n<div class=\"body\">\n<p>可以从海外连接善云的节点，但这种使用方式下，延迟会叠加当地到节点所在地区的距离。我们建议根据你所在地选择最近的入口节点，具体可在客户端里筛选。</p>\n</div>\n</details>\n\n<details>\n<summary>怎么联系你们？</summary>\n<div class=\"body\">\n<p>订阅成功后会收到一封欢迎邮件，里面包含工单入口、状态页和团队版专属客户经理的联系方式。所有问题都优先走工单，便于我们留下处理记录。</p>\n</div>\n</details>\n</section>\n\n<footer class=\"site\">\n<p>善云 ShanCloud · 2024 季度版现行规则 · 本页面仅介绍服务内容与套餐结构，不构成具体邀请或承诺。</p>\n</footer>\n</main>\n</div>",
